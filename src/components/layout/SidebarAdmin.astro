---
// src/components/layout/SidebarAdmin.astro
// Komponen sidebar navigasi SISKOM DSVK IPB — khusus role admin.
// Import: import SidebarAdmin from "../components/layout/SidebarAdmin.astro";

interface Props {
  userName?: string;
  userInitials?: string;
}

const { userName = "Memuat...", userInitials = "?" } = Astro.props;

// Ambil path halaman yang sedang aktif buat nentuin menu mana yang di-highlight.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (path: string) => currentPath === path;

// Class helper biar nggak nulis berkali-kali
const topActiveClass = "text-primary font-bold bg-primary/10 border-primary";
const topDefaultClass = "text-on-surface-variant font-medium hover:bg-surface-container-high";
---

<aside
  id="app-sidebar"
  class="fixed left-0 top-0 h-full w-[260px] flex flex-col pt-20 border-r border-outline-variant z-40 bg-surface-container-lowest transition-transform -translate-x-full md:translate-x-0"
>
  <div class="px-6 mb-8">
    <h2 class="font-title-lg text-title-lg font-extrabold text-primary tracking-tighter">
      SISKOM DSVK IPB
    </h2>
  </div>

  <nav class="flex-1 overflow-y-auto px-2 space-y-1">

    <!-- Beranda -->
    <a
      href="/admin/home"
      class={`flex items-center gap-3 px-4 py-3 rounded-lg group transition-colors ${
        isActive("/admin/home") ? topActiveClass : topDefaultClass
      }`}
    >
      <span class="material-symbols-outlined group-hover:text-primary">home</span>
      <span class="font-label-md text-label-md">Beranda</span>
    </a>

    <!-- Biodata -->
    <a
      href="/admin/profile"
      class={`flex items-center gap-3 px-4 py-3 rounded-lg group transition-colors ${
        isActive("/admin/profile") ? topActiveClass : topDefaultClass
      }`}
    >
      <span class="material-symbols-outlined group-hover:text-primary">person</span>
      <span class="font-label-md text-label-md">Profil</span>
    </a>

    <!-- Jadwal Kolokium -->
    <a
      href="/admin/jadwal-kolokium"
      class={`flex items-center gap-3 px-4 py-3 rounded-lg group transition-colors ${
        isActive("/admin/jadwal-kolokium") ? topActiveClass : topDefaultClass
      }`}
    >
      <span class="material-symbols-outlined group-hover:text-primary">school</span>
      <span class="font-label-md text-label-md">Jadwal Kolokium</span>
    </a>

    <!-- Jadwal Seminar -->
    <a
      href="/admin/jadwal-seminar"
      class={`flex items-center gap-3 px-4 py-3 rounded-lg group transition-colors ${
        isActive("/admin/jadwal-seminar") ? topActiveClass : topDefaultClass
      }`}
    >
      <span class="material-symbols-outlined group-hover:text-primary">co_present</span>
      <span class="font-label-md text-label-md">Jadwal Seminar</span>
    </a>

    <!-- Manajemen Akun -->
    <a
      href="/admin/tabel-akun"
      class={`flex items-center gap-3 px-4 py-3 rounded-lg group transition-colors ${
        isActive("/admin/tabel-akun") ? topActiveClass : topDefaultClass
      }`}
    >
      <span class="material-symbols-outlined group-hover:text-primary">people</span>
      <span class="font-label-md text-label-md">Manajemen Akun</span>
    </a>

    <!-- Keluar -->
    <button
      type="button"
      data-logout
      class="flex items-center gap-3 px-4 py-3 text-error font-medium hover:bg-error-container/20 transition-colors rounded-lg group mt-auto w-full text-left bg-transparent border-0 cursor-pointer"
    >
      <span class="material-symbols-outlined">logout</span>
      <span class="font-label-md text-label-md">Keluar</span>
    </button>
  </nav>

  <!-- User Info di Bawah Sidebar (konteks mobile) -->
  <!-- Admin: cuma nama, tanpa NIM/NIP -->
  <div class="p-4 border-t border-outline-variant flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-bold">
      <span id="sidebar-user-initials">{userInitials}</span>
    </div>
    <div>
      <p id="sidebar-user-name" class="font-label-md text-label-md text-on-surface font-bold">
        {userName}
      </p>
    </div>
  </div>
</aside>

<script>
  import { initLogoutButtons } from "../../scripts/api/logout.ts";
  import { initSidebarProfile } from "../../scripts/api/sidebar-profile.ts";

  function initSidebarToggle() {
    // Toggle sidebar untuk mobile, dipicu oleh tombol dengan id="sidebar-menu-btn"
    // yang ada di Navbar.
    const menuBtn = document.getElementById("sidebar-menu-btn");
    const sidebar = document.getElementById("app-sidebar");
    if (!menuBtn || !sidebar) return;

    let isOpen = false;

    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      isOpen = !isOpen;
      sidebar.classList.toggle("-translate-x-full", !isOpen);
      sidebar.classList.toggle("translate-x-0", isOpen);
    });

    document.addEventListener("click", (e) => {
      if (isOpen && !sidebar.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
        sidebar.classList.add("-translate-x-full");
        sidebar.classList.remove("translate-x-0");
        isOpen = false;
      }
    });
  }

  function initAll() {
    initSidebarToggle();
    initLogoutButtons();
    initSidebarProfile("none");
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>