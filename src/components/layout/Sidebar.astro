---
// src/layout/Sidebar.astro
// Komponen sidebar navigasi SISKOM DSVK IPB
// Import: import Sidebar from "../layout/Sidebar.astro";

interface Props {
  userName?: string;
  userNim?: string;
  userInitials?: string;
}

const {
  userName = "Rheynesta Hannover",
  userNim = "J0403231008",
  userInitials = "RH",
} = Astro.props;
---

<aside
  id="app-sidebar"
  class="fixed left-0 top-0 h-full w-[260px] flex flex-col pt-20 border-r border-outline-variant z-40 bg-surface-container-lowest transition-transform -translate-x-full md:translate-x-0"
>
  <div class="px-6 mb-8">
    <h2 class="font-title-lg text-title-lg font-extrabold text-primary tracking-tighter">
      SISKOM DSVK IPB
    </h2>
  </div>

  <nav class="flex-1 overflow-y-auto px-2 space-y-1">
    <!-- Beranda -->
    <a
      href="#"
      data-nav-item
      data-nav-level="top"
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant font-medium hover:bg-surface-container-high transition-colors rounded-lg group"
    >
      <span class="material-symbols-outlined group-hover:text-primary">home</span>
      <span class="font-label-md text-label-md">Beranda</span>
    </a>

    <!-- Biodata -->
    <a
      href="#"
      data-nav-item
      data-nav-level="top"
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant font-medium hover:bg-surface-container-high transition-colors rounded-lg group"
    >
      <span class="material-symbols-outlined group-hover:text-primary">person</span>
      <span class="font-label-md text-label-md">Biodata</span>
    </a>

    <!-- Kolokium (Dropdown) -->
    <div class="space-y-1" data-dropdown="kolokium">
      <button
        type="button"
        data-nav-item
        data-nav-level="top"
        data-dropdown-btn
        class="w-full flex items-center justify-between px-4 py-3 text-primary font-bold bg-primary-fixed-dim/10 rounded-lg"
      >
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">school</span>
          <span class="font-label-md text-label-md">Kolokium</span>
        </div>
        <span
          data-dropdown-chevron
          class="material-symbols-outlined text-sm transition-transform duration-200"
        >
          expand_more
        </span>
      </button>

      <div data-dropdown-menu class="pl-12 space-y-1">
        <a
          href="#"
          data-nav-item
          data-nav-level="sub"
          class="block px-4 py-2 text-on-primary-container font-bold bg-secondary-container border-l-4 border-secondary transition-all"
        >
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full border border-secondary"></span>
            <span class="font-label-md text-label-md">Jadwal Kolokium</span>
          </div>
        </a>
        <a
          href="#"
          data-nav-item
          data-nav-level="sub"
          class="block px-4 py-2 text-on-surface-variant hover:text-primary font-medium transition-colors"
        >
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full border border-outline"></span>
            <span class="font-label-md text-label-md">Daftar Kolokium</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Seminar (Dropdown) -->
    <div class="space-y-1" data-dropdown="seminar">
      <button
        type="button"
        data-nav-item
        data-nav-level="top"
        data-dropdown-btn
        class="w-full flex items-center justify-between px-4 py-3 text-on-surface-variant font-medium hover:bg-surface-container-high transition-colors rounded-lg group"
      >
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined group-hover:text-primary">co_present</span>
          <span class="font-label-md text-label-md">Seminar</span>
        </div>
        <span
          data-dropdown-chevron
          class="material-symbols-outlined text-sm transition-transform duration-200"
          style="transform: rotate(-90deg);"
        >
          expand_more
        </span>
      </button>

      <div data-dropdown-menu class="pl-12 space-y-1 hidden">
        <a
          href="#"
          data-nav-item
          data-nav-level="sub"
          class="block px-4 py-2 text-on-surface-variant hover:text-primary font-medium transition-colors"
        >
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full border border-outline"></span>
            <span class="font-label-md text-label-md">Jadwal Seminar</span>
          </div>
        </a>
        <a
          href="#"
          data-nav-item
          data-nav-level="sub"
          class="block px-4 py-2 text-on-surface-variant hover:text-primary font-medium transition-colors"
        >
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full border border-outline"></span>
            <span class="font-label-md text-label-md">Daftar Seminar</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Keluar (tidak ikut sistem active/switch) -->
    <a
      href="#"
      class="flex items-center gap-3 px-4 py-3 text-error font-medium hover:bg-error-container/20 transition-colors rounded-lg group mt-auto"
    >
      <span class="material-symbols-outlined">logout</span>
      <span class="font-label-md text-label-md">Keluar</span>
    </a>
  </nav>

  <!-- User Info di Bawah Sidebar (konteks mobile) -->
  <div class="p-4 border-t border-outline-variant flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-bold">
      {userInitials}
    </div>
    <div>
      <p class="font-label-md text-label-md text-on-surface font-bold">{userName}</p>
      <p class="text-[10px] text-on-surface-variant">{userNim}</p>
    </div>
  </div>
</aside>

<script>
  // Class default (non-aktif) untuk tiap level nav, dipakai untuk reset sebelum
  // menandai item yang baru diklik sebagai aktif.
  const TOP_DEFAULT_CLASSES = [
    "text-on-surface-variant",
    "font-medium",
    "hover:bg-surface-container-high",
  ];
  const TOP_ACTIVE_CLASSES = ["text-primary", "font-bold", "bg-primary-fixed-dim/10"];

  const SUB_DEFAULT_CLASSES = ["text-on-surface-variant", "hover:text-primary", "font-medium"];
  const SUB_ACTIVE_CLASSES = [
    "text-on-primary-container",
    "font-bold",
    "bg-secondary-container",
    "border-l-4",
    "border-secondary",
  ];

  function setActive(el: HTMLElement) {
    // Reset semua nav-item ke style default sesuai levelnya masing-masing
    document.querySelectorAll<HTMLElement>("[data-nav-item]").forEach((item) => {
      const itemIsTop = item.dataset.navLevel === "top";
      const activeClasses = itemIsTop ? TOP_ACTIVE_CLASSES : SUB_ACTIVE_CLASSES;
      const defaultClasses = itemIsTop ? TOP_DEFAULT_CLASSES : SUB_DEFAULT_CLASSES;

      item.classList.remove(...activeClasses);
      item.classList.add(...defaultClasses);
    });

    // Tandai item yang baru diklik sebagai aktif
    const isTop = el.dataset.navLevel === "top";
    const activeClasses = isTop ? TOP_ACTIVE_CLASSES : SUB_ACTIVE_CLASSES;
    const defaultClasses = isTop ? TOP_DEFAULT_CLASSES : SUB_DEFAULT_CLASSES;
    el.classList.remove(...defaultClasses);
    el.classList.add(...activeClasses);
  }

  function initSidebarNav() {
    const navItems = document.querySelectorAll<HTMLElement>("[data-nav-item]");

    navItems.forEach((item) => {
      item.addEventListener("click", (e) => {
        // Tombol dropdown (Kolokium/Seminar) cuma buka/tutup submenu,
        // bukan pindah halaman, jadi diserahkan ke handler dropdown di bawah.
        if (item.hasAttribute("data-dropdown-btn")) return;

        e.preventDefault();
        setActive(item);
      });
    });
  }

  function initDropdowns() {
    document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((group) => {
      const btn = group.querySelector<HTMLElement>("[data-dropdown-btn]");
      const menu = group.querySelector<HTMLElement>("[data-dropdown-menu]");
      const chevron = group.querySelector<HTMLElement>("[data-dropdown-chevron]");
      if (!btn || !menu || !chevron) return;

      let isOpen = !menu.classList.contains("hidden");

      btn.addEventListener("click", () => {
        isOpen = !isOpen;
        menu.classList.toggle("hidden", !isOpen);
        chevron.style.transform = isOpen ? "rotate(0deg)" : "rotate(-90deg)";
      });
    });
  }

  function initSidebarToggle() {
    // Toggle sidebar untuk mobile, dipicu oleh tombol dengan id="sidebar-menu-btn"
    // yang ada di Navbar.
    const menuBtn = document.getElementById("sidebar-menu-btn");
    const sidebar = document.getElementById("app-sidebar");
    if (!menuBtn || !sidebar) return;

    let isOpen = false;

    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      isOpen = !isOpen;
      sidebar.classList.toggle("-translate-x-full", !isOpen);
      sidebar.classList.toggle("translate-x-0", isOpen);
    });

    document.addEventListener("click", (e) => {
      if (isOpen && !sidebar.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
        sidebar.classList.add("-translate-x-full");
        sidebar.classList.remove("translate-x-0");
        isOpen = false;
      }
    });
  }

  function initAll() {
    initSidebarNav();
    initDropdowns();
    initSidebarToggle();
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>