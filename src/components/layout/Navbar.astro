---
// src/layout/Navbar.astro
// Komponen top navigation bar
// Import: import Navbar from "../layout/Navbar.astro";

interface Props {
  title?: string;
}

const { title = "SISKOM DSVK" } = Astro.props;
---

<header
  class="fixed top-0 left-0 w-full z-50 flex items-center justify-between px-margin-desktop h-16 bg-ipb-blue text-on-primary shadow-sm"
>
  <div class="flex items-center gap-4">
    <button id="sidebar-menu-btn" type="button" class="md:hidden text-on-primary p-2">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <h1 class="font-headline-md text-headline-md font-bold tracking-tight">{title}</h1>
  </div>

  <div class="flex items-center gap-6">
    <div class="flex items-center gap-2">
    </div>
  </div>
</header>