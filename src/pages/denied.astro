---
// src/pages/denied.astro
// Halaman ditampilkan ketika user mencoba mengakses route yang tidak sesuai
// dengan role akunnya (mis. mahasiswa membuka /admin/home).
// Dibuat berdiri sendiri (bukan pakai Layout.astro), mengikuti desain
// yang sama dengan login.astro & register.astro (navbar + card di tengah).
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SISKOM DSVK - Akses Ditolak</title>

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
    />

    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config" is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              "brand-green": "#1B4332",
              "nav-bg": "#BEE1E6",
            },
            fontFamily: {
              sans: ["Inter", "sans-serif"],
            },
          },
        },
      };
    </script>
  </head>

  <body class="min-h-screen flex flex-col antialiased text-gray-900 bg-[#FAFAFA] font-sans">
    <!-- BEGIN: Navbar -->
    <header
      class="shadow-sm w-full py-4 px-6 flex justify-between items-center bg-[#00467E]"
      data-purpose="top-navigation"
    >
      <!-- Brand Logo/Text -->
      <div class="text-white font-bold text-xl tracking-wide uppercase">SISKOM DSVK IPB</div>
    </header>
    <!-- END: Navbar -->

    <!-- BEGIN: Main Content Area -->
    <main class="flex-grow flex items-center justify-center p-4 min-h-screen">
      <!-- Unassigned Card Container -->
      <div
        class="bg-white rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] w-full max-w-md p-8 sm:p-10 text-center"
        data-purpose="unassigned-card"
      >
        <!-- Card Title -->
        <h1 class="text-center text-xl font-bold mb-8 text-black tracking-tight">
          SISKOM DSVK IPB
        </h1>

        <!-- Icon -->
        <div class="mx-auto mb-6 flex items-center justify-center w-16 h-16 rounded-full bg-red-50">
          <span class="material-symbols-outlined text-red-600" style="font-size: 32px;">
            block
          </span>
        </div>

        <!-- Heading -->
        <h2 class="text-lg font-bold text-gray-900 mb-2">Role Tidak Sesuai</h2>

        <!-- Message -->
        <p class="text-sm text-gray-500 mb-1">
          Anda tidak memiliki akses untuk membuka halaman ini.
        </p>
        <p id="role-info" class="text-sm text-gray-500 mb-8">
          Halaman ini tidak sesuai dengan role akun Anda saat ini.
        </p>

        <!-- Actions -->
        <div class="flex flex-col gap-3">
          <button
            type="button"
            id="btn-back-home"
            class="w-full flex justify-center items-center gap-2 py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-bold text-white bg-brand-green hover:bg-[#123023] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-green transition-colors duration-200"
          >
            <span class="material-symbols-outlined text-lg">home</span>
            Kembali ke Halaman Saya
          </button>

          <button
            type="button"
            id="btn-logout"
            class="w-full flex justify-center items-center gap-2 py-3 px-4 border border-gray-200 rounded-md shadow-sm text-sm font-bold text-red-600 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-green transition-colors duration-200"
          >
            <span class="material-symbols-outlined text-lg">logout</span>
            Logout
          </button>
        </div>
      </div>
    </main>
    <!-- END: Main Content Area -->

    <script>
      type Role = "admin" | "dosen" | "mahasiswa";

      interface StoredUser {
        role?: Role;
        nama?: string;
        username?: string;
        [key: string]: unknown;
      }

      const REDIRECT_BY_ROLE: Record<Role, string> = {
        admin: "/admin/home",
        dosen: "/dosen/home",
        mahasiswa: "/mahasiswa/home",
      };

      const ROLE_LABEL: Record<Role, string> = {
        admin: "Admin",
        dosen: "Dosen",
        mahasiswa: "Mahasiswa",
      };

      function getStoredUser(): StoredUser | null {
        try {
          const raw = localStorage.getItem("auth_user");
          if (!raw) return null;
          return JSON.parse(raw) as StoredUser;
        } catch {
          return null;
        }
      }

      function init(): void {
        const roleInfo = document.getElementById("role-info");
        const btnBackHome = document.getElementById("btn-back-home") as HTMLButtonElement | null;
        const btnLogout = document.getElementById("btn-logout") as HTMLButtonElement | null;

        const user = getStoredUser();
        const role = user?.role;

        if (roleInfo && role && ROLE_LABEL[role]) {
          roleInfo.textContent = `Akun Anda terdaftar sebagai ${ROLE_LABEL[role]}. Silakan kembali ke halaman yang sesuai.`;
        }

        btnBackHome?.addEventListener("click", () => {
          if (role && REDIRECT_BY_ROLE[role]) {
            window.location.href = REDIRECT_BY_ROLE[role];
          } else {
            window.location.href = "/";
          }
        });

        btnLogout?.addEventListener("click", () => {
          localStorage.removeItem("auth_token");
          localStorage.removeItem("auth_user");
          window.location.href = "/";
        });
      }

      init();
    </script>
  </body>
</html>