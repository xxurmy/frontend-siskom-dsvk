---
// src/pages/biodata.astro
// Halaman Biodata Mahasiswa — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini).

import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="dosen" pageTitle="Biodata Dosen - SISKOM DSVK" navTitle="Biodata">
  <div class="max-w-container-max mx-auto w-full">
    <!-- Biodata Form Card -->
    <div class="bg-surface-container-lowest rounded-lg border border-outline-variant p-stack-lg shadow-sm">
      <!-- Card Header -->
      <div class="text-center mb-stack-lg border-b border-outline-variant pb-stack-md">
        <h2 class="font-headline-md text-headline-md text-on-surface">ISI DATA Dosen
        </h2>
      </div>

      <!-- Profile Photo Section -->
      <div class="flex flex-col items-center mb-stack-lg">
        <div class="w-32 h-40 bg-surface-container-highest rounded border border-outline-variant mb-stack-sm overflow-hidden blur-[2px]">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBRAQeevHGlkXWuhY5Cpbrc7q3GnnkJdesGN37MyJ2LOPXWHg8EmhdRtqEOVFphe8ie9c7eEA3VoR1-f0jRt4a0PfkXSXhlHbBc1-qWQjL4yXO3jW9IZRlqnGqkv_crwvbQqcmAvYbUHVbMJ1vig3UwH6R1ZCU_6PZE6Pyv6CWniSqBfSQQJb9NcKfKDxw9K0zarrnvqws87q9ueCvQNiOsvAaiNn0GsOCdwc3vt7_pc5AcZtKKf3u1tX_uqmCO4WmQhSytLcj0yAI"
            alt="Student Photo"
            class="w-full h-full object-cover"
          />
        </div>
        <button
          type="button"
          class="bg-ipb-blue-light hover:bg-blue-600 text-white font-body-sm text-body-sm py-1.5 px-6 rounded flex items-center gap-2 transition-colors"
        >
          <span class="material-symbols-outlined text-[16px]">edit</span>
          Edit Foto
        </button>
      </div>

      <!-- Form Fields -->
      <div class="space-y-stack-md max-w-3xl mx-auto">
        <!-- Nama -->
        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
          <label class="font-body-md text-body-md text-on-surface w-full md:w-1/4">Nama</label>
          <input
            type="text"
            readonly
            value="Rheynesta Hannover"
            class="w-full md:w-3/4 bg-surface-container-low border border-outline-variant rounded p-2 text-on-surface-variant focus:ring-primary focus:border-primary"
          />
        </div>

        <!-- NIM -->
        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
          <label class="font-body-md text-body-md text-on-surface w-full md:w-1/4">NIP</label>
          <input
            type="text"
            readonly
            value="J0403231008"
            class="w-full md:w-3/4 bg-surface-container-low border border-outline-variant rounded p-2 text-on-surface-variant focus:ring-primary focus:border-primary"
          />
        </div>

        <!-- Email -->
        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
          <label class="font-body-md text-body-md text-on-surface w-full md:w-1/4">
            Email <span class="text-error">*</span>
          </label>
          <input
            type="email"
            placeholder="Tuliskan alamat email"
            class="w-full md:w-3/4 bg-surface-container-lowest border border-outline-variant rounded p-2 text-on-surface focus:ring-primary focus:border-primary"
          />
        </div>

        <!-- Signature Section -->
        <div class="flex flex-col md:flex-row gap-4 pt-stack-md">
          <div class="w-full md:w-1/4">
            <label class="font-body-md text-body-md text-on-surface">Tanda Tangan</label>
          </div>

          <!-- Preview Area -->
          <div class="w-full md:w-1/4 flex flex-col gap-2">
            <span class="font-body-md text-body-md text-on-surface font-medium">Preview</span>
            <div class="w-full h-24 bg-surface-container-lowest border border-outline-variant rounded flex items-center justify-center opacity-50 blur-[1px]">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDivISMmj0dhXiFayU8gIjHYoL1hwOafQXTKo--7btvEP99JXCVa6crTRUU-BG_z1s7GJVlLVQD5CfMb4pUEPQ_6oNL8hBk43zmmq4UT2miw0KKdTg031tPj7L6fUu5PVTZxsonsbiAm-XRI6X_6j_xxbGTSFxT3PbIbToA7t2_IzdphjZzF7JkoH7oKfPDI5pBIGfUlGbtkRjjBDEKHELycRMIxYAbhSxPOlzR-HNTRzbK95_wYmxuBcBsgAJqxEAp2XRuboOdCrM"
                alt="Signature Preview"
                class="h-16 object-contain"
              />
            </div>
          </div>

          <!-- Input Area -->
          <div class="w-full md:w-2/4 flex flex-col gap-2">
            <div class="border border-error rounded p-2 text-error text-sm mb-2 bg-error-container/20">
              Gambar Tanda tangan dibawah atau Upload Tanda tangan pada tombol
              <span class="font-medium">"Unggah Gambar"</span>
            </div>

            <!-- Kanvas untuk gambar tanda tangan -->
            <div
              id="signature-pad-container"
              class="w-full h-32 border-2 border-dashed border-error rounded bg-surface-container-lowest"
            >
              <canvas id="signature-pad" class="w-full h-full touch-none"></canvas>
            </div>

            <div class="flex gap-2 mt-2">
              <button
                type="button"
                id="signature-clear-btn"
                class="bg-error hover:bg-error/90 text-on-error font-body-sm text-body-sm py-1.5 px-4 rounded transition-colors"
              >
                Hapus
              </button>
              <button
                type="button"
                id="signature-preview-btn"
                class="bg-ipb-blue hover:bg-blue-600 text-white font-body-sm text-body-sm py-1.5 px-4 rounded transition-colors"
              >
                Lihat Tampilan
              </button>
              <button
                type="button"
                id="signature-upload-btn"
                class="bg-outline hover:bg-outline/90 text-white font-body-sm text-body-sm py-1.5 px-4 rounded transition-colors"
              >
                Unggah Gambar
              </button>
              <input type="file" id="signature-upload-input" accept="image/*" class="hidden" />
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-stack-lg mt-stack-lg border-t border-outline-variant">
          <button
            type="submit"
            id="biodata-submit-btn"
            class="w-full bg-primary-container hover:bg-primary text-on-primary font-title-lg text-title-lg py-3 rounded flex items-center justify-center gap-2 transition-colors"
          >
            <span class="material-symbols-outlined">save</span>
            Simpan
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="../../script-signature/biodata-signature.ts"></script>
</Layout>