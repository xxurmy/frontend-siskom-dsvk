---
// src/pages/jadwal-seminar.astro
// Halaman Jadwal Seminar — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini; footer juga sudah ada di Layout).

import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="dosen" pageTitle="Jadwal Seminar - SISKOM DSVK" navTitle="Jadwal Seminar">
  <!-- Content Card -->
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl flex-1 flex flex-col overflow-hidden shadow-[0px_4px_12px_rgba(0,0,0,0.03)]">
    <!-- Table Header Actions -->
    <div class="p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-outline-variant">
      <div class="space-y-1">
        <h2 class="font-headline-md text-headline-md text-primary font-bold">JADWAL SEMINAR</h2>
        <p class="text-body-sm text-on-surface-variant">
          Menampilkan jadwal seminar mahasiswa aktif program studi.
        </p>
      </div>
      <a href="/dosen/kartu-seminar">
      <button
        type="button"
        class="bg-primary-container text-on-primary px-6 py-2.5 rounded-lg font-bold flex items-center gap-2 hover:bg-primary transition-all active:scale-95 shadow-md"
      >
        <span class="material-symbols-outlined">badge</span>
        Lihat Kartu Seminar
      </button>
      </a>
    </div>

    <!-- Search and Entries Filter -->
    <div class="px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-surface-container-low/50">
      <div class="flex items-center gap-2 text-body-sm text-on-surface-variant">
        <span>Show</span>
        <select id="entries-select" class="w-14 h-9 border border-outline-variant rounded-md bg-surface px-2 text-sm outline-none focus:border-primary">
          <option value="5">5</option>
          <option value="10" selected>10</option>
          <option value="25">25</option>
        </select>
        <span>entries</span>
      </div>
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline text-lg">
          search
        </span>
        <input
          id="search-input"
          type="text"
          placeholder="Search data..."
          class="pl-10 pr-4 py-2 border border-outline-variant rounded-lg w-full sm:w-64 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
        />
      </div>
    </div>

    <!-- Table Container -->
    <div class="flex-1 overflow-x-auto custom-scrollbar">
      <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-high sticky top-0 z-10">
          <tr>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              No
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Tanggal
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Waktu
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Ruangan
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Nama Pemrasaran
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Nim Pemrasaran
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Prodi
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Judul
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Jumlah Forum
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Dosen Pembimbing
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Moderator
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant text-center whitespace-nowrap">
              Absensi
            </th>
          </tr>
        </thead>
        <tbody id="seminar-table-body" class="divide-y divide-outline-variant/30">
          <tr>
            <td colspan="12" class="px-4 py-6 text-center text-body-sm text-on-surface-variant">Memuat data...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer -->
    <div class="px-6 py-4 border-t border-outline-variant flex flex-col sm:flex-row items-center justify-between gap-4 bg-surface-container-low/30">
      <p id="pagination-info" class="text-body-sm text-on-surface-variant">Memuat...</p>
      <div id="pagination-buttons" class="flex items-center gap-1"></div>
    </div>
  </div>

  <script src="../../scripts/api/dosen/jadwal-seminar.ts"></script>
</Layout>