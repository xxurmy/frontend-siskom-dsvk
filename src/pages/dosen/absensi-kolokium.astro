---
import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="dosen" pageTitle="Daftar Peserta Kolokium - SISKOM DSVK" navTitle="Jadwal Kolokium">
  <!-- Action -->
  <div class="flex justify-end mb-6">
    <a
      href="/dosen/jadwal-kolokium"
      class="bg-[#ffc107] hover:brightness-95 text-on-surface px-5 py-2.5 rounded-lg font-bold flex items-center gap-2 transition-all active:scale-95"
    >
      <span class="material-symbols-outlined">arrow_back</span>
      Kembali
    </a>
  </div>

  <!-- Pesan status (error) -->
  <div id="absensi-message" class="hidden mb-4 px-4 py-3 rounded-lg text-body-sm font-medium"></div>

  <!-- Info Kolokium -->
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 mb-6 shadow-[0px_4px_12px_rgba(0,0,0,0.03)]">
    <h2 class="font-headline-md text-headline-md text-primary font-bold mb-4">
      INFORMASI KOLOKIUM
    </h2>
    <div id="kolokium-info" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-3">
      <p class="text-body-sm text-on-surface-variant col-span-full">Memuat informasi kolokium...</p>
    </div>
  </div>

  <!-- Main Card -->
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl flex-1 flex flex-col overflow-hidden shadow-[0px_4px_12px_rgba(0,0,0,0.03)]">

    <!-- Header -->
    <div class="p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-outline-variant">
      <div class="space-y-1">
        <h2 class="font-headline-md text-headline-md text-primary font-bold">
          DAFTAR PESERTA
        </h2>
        <p class="text-body-sm text-on-surface-variant">
          Daftar peserta forum kolokium ini.
        </p>
      </div>
    </div>

    <!-- Table -->
    <div class="flex-1 overflow-x-auto custom-scrollbar">

      <table class="w-full text-left border-collapse">

        <thead class="bg-surface-container-high sticky top-0 z-10">
          <tr>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              No
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Nama
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              NIM
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Prodi
            </th>
          </tr>
        </thead>

        <tbody id="absensi-tbody" class="divide-y divide-outline-variant/30">
          <tr>
            <td colspan="4" class="px-4 py-8 text-center text-body-sm text-on-surface-variant">
              Memuat data...
            </td>
          </tr>
        </tbody>

      </table>

    </div>

  </div>

  <script src="../../scripts/api/dosen/absensi-kolokium.ts"></script>
</Layout>