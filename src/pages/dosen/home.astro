---
// src/pages/dosen/home.astro
// Halaman dashboard Dosen — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini).

import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="dosen" pageTitle="SISKOM DSVK IPB - Dosen Dashboard" navTitle="Beranda">
  <div class="max-w-container-max mx-auto space-y-gutter pb-8 w-full">
    <!-- Top Row: Profile & Stats -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
      <!-- Profile Card -->
      <div class="lg:col-span-5 bg-surface-container-lowest border border-outline-variant rounded-xl p-stack-lg shadow-[0_4px_12px_rgba(0,0,0,0.03)] flex flex-col justify-center">
        <div class="flex items-center gap-6 mb-6">
          <div class="w-20 h-20 rounded-full border-4 border-surface-container-low overflow-hidden shrink-0">
            <img
              id="profile-foto"
              src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg"
              alt="Foto profil dosen"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <h2 id="profile-nama" class="font-headline-md text-headline-md text-on-surface mb-1">
              Memuat...
            </h2>
          </div>
        </div>
        <div class="bg-surface-container-low rounded-lg p-4 border border-outline-variant/50">
          <span class="font-label-md text-label-md text-on-surface-variant block mb-1">NIP</span>
          <span id="profile-nip" class="font-body-md text-body-md text-on-surface font-medium">
            Memuat...
          </span>
        </div>
      </div>

      <!-- Stats Cards Container -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-gutter">
      <!-- Stat Card 1 -->
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 flex flex-col hover:bg-surface-container-low/30 transition-colors">
        <!-- Icon -->
        <div class="w-12 h-12 bg-[#E8EAF6] text-[#3F51B5] rounded-lg flex items-center justify-center">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">
            school
          </span>
        </div>

        <!-- Judul di tengah -->
        <div class="flex-1 flex items-center">
          <p class="font-title-lg text-title-lg text-on-surface">
            Jumlah Kolokium yang Dihadiri
          </p>
        </div>

        <!-- Angka di bawah -->
        <div class="flex items-baseline gap-2 mt-3">
          <span id="stat-kolokium-dihadiri" class="font-display-lg text-display-lg text-[#00467E]">-</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant">
            kolokium
          </span>
        </div>
      </div>

      <!-- Stat Card 2 -->
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 flex flex-col hover:bg-surface-container-low/30 transition-colors">
        <!-- Icon -->
        <div class="w-12 h-12 bg-[#FFF3E0] text-[#E65100] rounded-lg flex items-center justify-center">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">
            event
          </span>
        </div>

        <!-- Judul di tengah -->
        <div class="flex-1 flex items-center">
          <p class="font-title-lg text-title-lg text-on-surface">
            Jumlah Seminar yang Dihadiri
          </p>
        </div>

        <!-- Angka di bawah -->
        <div class="flex items-baseline gap-2 mt-3">
          <span id="stat-seminar-dihadiri" class="font-display-lg text-display-lg text-[#00467E]">-</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant">
            seminar
          </span>
        </div>
      </div>
    </div>
    </div>

    <!-- Middle Row: Urgent Actions & Schedule -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
      <!-- Urgent Actions Container -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-gutter">
        <!-- Urgent Card 1 -->
        <div class="bg-surface-container-lowest rounded-xl p-stack-lg relative overflow-hidden border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
          <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#D32F2F]"></div>
          <div class="pl-2">
            <div class="flex justify-between items-start mb-6">
              <div class="flex items-center gap-2 text-on-surface">
                <span class="material-symbols-outlined text-[#D32F2F]" style="font-variation-settings: 'FILL' 1;">
                  warning
                </span>
                <h3 class="font-title-lg text-title-lg text-on-surface">Jumlah Kartu Kolokium</h3>
              </div>
              <span class="bg-[#FFEBEE] text-[#D32F2F] px-2 py-1 rounded text-xs font-bold uppercase tracking-wider">
                Urgent
              </span>
            </div>
            <div class="text-center mb-6">
              <span id="urgent-kolokium-count" class="font-display-lg text-display-lg text-[#D32F2F] block">-</span>
              <span class="font-body-sm text-body-sm text-on-surface-variant">Belum ditanda tangani</span>
            </div>
            <a href="/dosen/kartu-kolokium" class="block w-full">
              <button
                type="button"
                class="w-full py-2 px-4 border border-[#004D40] text-[#004D40] rounded-lg font-label-md text-label-md hover:bg-[#004D40]/5 transition-colors font-medium"
              >
                Lihat Detail
              </button>
            </a>
          </div>
        </div>

        <!-- Urgent Card 2 -->
        <div class="bg-surface-container-lowest rounded-xl p-stack-lg relative overflow-hidden border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
          <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#D32F2F]"></div>
          <div class="pl-2">
            <div class="flex justify-between items-start mb-6">
              <div class="flex items-center gap-2 text-on-surface">
                <span class="material-symbols-outlined text-[#D32F2F]" style="font-variation-settings: 'FILL' 1;">
                  warning
                </span>
                <h3 class="font-title-lg text-title-lg text-on-surface">Jumlah Kartu Seminar</h3>
              </div>
              <span class="bg-[#FFEBEE] text-[#D32F2F] px-2 py-1 rounded text-xs font-bold uppercase tracking-wider">
                Urgent
              </span>
            </div>
            <div class="text-center mb-6">
              <span id="urgent-seminar-count" class="font-display-lg text-display-lg text-[#D32F2F] block">-</span>
              <span class="font-body-sm text-body-sm text-on-surface-variant">Belum ditanda tangani</span>
            </div>
            <a href="/dosen/kartu-seminar" class="block w-full">
              <button
                type="button"
                class="w-full py-2 px-4 border border-[#004D40] text-[#004D40] rounded-lg font-label-md text-label-md hover:bg-[#004D40]/5 transition-colors font-medium"
              >
                Lihat Detail
              </button>
            </a>
          </div>
        </div>
      </div>

      <!-- Daily Schedule -->
      <div class="lg:col-span-5 bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden flex flex-col">
        <div class="p-4 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/50">
          <h3 class="font-title-lg text-title-lg text-on-surface">Jadwal Hari Ini</h3>
        </div>
        <ul id="jadwal-list" class="flex-1 overflow-y-auto">
          <li class="p-4 text-center text-sm text-on-surface-variant">Memuat jadwal...</li>
        </ul>
      </div>
    </div>
  </div>

  <script src="../../scripts/api/dosen/home.ts"></script>
</Layout>