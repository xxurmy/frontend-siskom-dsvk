---
// src/pages/dosen/home.astro
// Halaman dashboard Dosen — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini).

import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="dosen" pageTitle="SISKOM DSVK IPB - Dosen Dashboard" navTitle="Beranda">
  <div class="max-w-container-max mx-auto space-y-gutter pb-8 w-full">

    <!-- Baris 1: Profile Card + Stats Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
      <!-- Profile Card -->
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-stack-lg shadow-[0_4px_12px_rgba(0,0,0,0.03)] flex flex-col justify-center">
        <div class="flex items-center gap-6 mb-6">
          <div
            class="w-20 h-20 rounded-full bg-blue-50 flex items-center justify-center flex-shrink-0 border-4 border-white shadow-sm relative overflow-hidden"
          >
            <div class="absolute inset-0 flex items-end justify-center pb-2">
              <div class="w-14 h-14 rounded-full bg-blue-200 flex flex-col items-center justify-end overflow-hidden">
                <div class="w-7 h-7 rounded-full bg-blue-500 mb-1"></div>
                <div class="w-10 h-5 rounded-t-full bg-blue-500"></div>
              </div>
            </div>
          </div>
          <div>
            <h2 id="profile-nama" class="font-headline-md text-headline-md text-on-surface mb-1">
              Memuat...
            </h2>
          </div>
        </div>
        <div class="bg-surface-container-low rounded-lg p-4 border border-outline-variant/50">
          <span class="font-label-md text-label-md text-on-surface-variant block mb-1">NIP</span>
          <span id="profile-nip" class="font-body-md text-body-md text-on-surface font-medium">
            Memuat...
          </span>
        </div>
      </div>

      <!-- Stat Card 1 -->
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 flex flex-col hover:bg-surface-container-low/30 transition-colors">
        <!-- Icon -->
        <div class="w-12 h-12 bg-[#E8EAF6] text-[#3F51B5] rounded-lg flex items-center justify-center">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">
            school
          </span>
        </div>

        <!-- Judul di tengah -->
        <div class="flex-1 flex items-center">
          <p class="font-title-lg text-title-lg text-on-surface">
            Jumlah Kolokium yang Dihadiri
          </p>
        </div>

        <!-- Angka di bawah -->
        <div class="flex items-baseline gap-2 mt-3">
          <span id="stat-kolokium-dihadiri" class="font-display-lg text-display-lg text-[#00467E]">-</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant">
            kolokium
          </span>
        </div>
      </div>

      <!-- Stat Card 2 -->
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-4 flex flex-col hover:bg-surface-container-low/30 transition-colors">
        <!-- Icon -->
        <div class="w-12 h-12 bg-[#FFF3E0] text-[#E65100] rounded-lg flex items-center justify-center">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">
            event
          </span>
        </div>

        <!-- Judul di tengah -->
        <div class="flex-1 flex items-center">
          <p class="font-title-lg text-title-lg text-on-surface">
            Jumlah Seminar yang Dihadiri
          </p>
        </div>

        <!-- Angka di bawah -->
        <div class="flex items-baseline gap-2 mt-3">
          <span id="stat-seminar-dihadiri" class="font-display-lg text-display-lg text-[#00467E]">-</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant">
            seminar
          </span>
        </div>
      </div>
    </div>

    <!-- Baris 2: Jadwal Hari Ini -->
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden flex flex-col">
      <div class="p-4 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/50">
        <h3 class="font-title-lg text-title-lg text-on-surface">Jadwal Hari Ini</h3>
      </div>
      <ul id="jadwal-list" class="flex-1 overflow-y-auto">
        <li class="p-4 text-center text-sm text-on-surface-variant">Memuat jadwal...</li>
      </ul>
    </div>

  </div>

  <script src="../../scripts/api/dosen/home.ts"></script>
</Layout> 