---
// src/pages/forgot-password.astro
// Halaman lupa password SISKOM DSVK — desain senada dengan login.astro
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SISKOM DSVK - Lupa Password</title>

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
    />

    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config" is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              "brand-green": "#1B4332",
              "nav-bg": "#BEE1E6",
            },
            fontFamily: {
              sans: ["Inter", "sans-serif"],
            },
          },
        },
      };
    </script>
  </head>

  <body class="min-h-screen flex flex-col antialiased text-gray-900 bg-[#FAFAFA] font-sans">
    <!-- BEGIN: Navbar -->
    <header
      class="shadow-sm w-full py-4 px-6 flex justify-between items-center bg-[#00467E]"
      data-purpose="top-navigation"
    >
      <div class="text-white font-bold text-xl tracking-wide uppercase">SISKOM DSVK IPB</div>
    </header>
    <!-- END: Navbar -->

    <!-- BEGIN: Main Content Area -->
    <main class="flex-grow flex items-center justify-center p-4 min-h-screen">
      <div
        class="bg-white rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.08)] w-full max-w-md p-8 sm:p-10"
        data-purpose="forgot-password-form-card"
      >
        <h1 class="text-center text-xl font-bold mb-2 text-black tracking-tight">
          Lupa Password
        </h1>
        <p class="text-center text-sm text-gray-500 mb-8">
          Masukkan email akun Anda, kami akan kirimkan link untuk reset password.
        </p>

        <!-- Pesan error -->
        <div
          id="forgot-error"
          class="hidden mb-4 text-sm text-red-600 bg-red-50 border border-red-200 rounded-md px-4 py-2"
        ></div>

        <!-- Pesan sukses -->
        <div
          id="forgot-success"
          class="hidden mb-4 text-sm text-green-700 bg-green-50 border border-green-200 rounded-md px-4 py-2"
        ></div>

        <!-- Forgot Password Form -->
        <form id="forgot-password-form" method="POST" action="#" class="space-y-6">
          <div>
            <label for="email" class="sr-only">Email</label>
            <div class="relative">
              <input
                type="email"
                id="email"
                name="email"
                placeholder="Email"
                required
                class="appearance-none block w-full px-4 py-3 border border-gray-200 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-brand-green focus:border-brand-green sm:text-sm font-semibold text-gray-700 bg-gray-50/50"
              />
            </div>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="forgot-submit"
              class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-bold text-white bg-brand-green hover:bg-[#123023] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-green transition-colors duration-200 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Kirim Link Reset Password
            </button>
          </div>

          <div class="flex items-center justify-center pt-1">
            <a href="/" class="text-sm font-medium text-blue-500 hover:text-blue-600">
              &larr; Kembali ke Login
            </a>
          </div>
        </form>
      </div>
    </main>
    <!-- END: Main Content Area -->

    <script src="../scripts/api/forgot-password.ts"></script>
  </body>
</html>