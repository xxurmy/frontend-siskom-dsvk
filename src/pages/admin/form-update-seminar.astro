---
// src/pages/update-seminar.astro
// Halaman Update Seminar (Admin) — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini).
// Logic fetch/render ada di ../../scripts/form-update-seminar.ts (lihat <script> di bawah).
// Halaman ini butuh query string ?id=<id_seminar>, mis. /update-seminar?id=3

import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="admin" pageTitle="Update Seminar - SISKOM DSVK" navTitle="Update Seminar">
  <!-- Status Card -->
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-8 mb-6 shadow-sm">
      <div class="flex flex-col gap-3 sm:grid sm:grid-cols-3 sm:items-center">
        <h2 class="font-title-lg text-title-lg text-on-surface">
          Status Seminar
        </h2>

        <div class="flex justify-start sm:justify-center">
          <div class="relative inline-block">
            <select
              id="status_seminar"
              name="status_seminar"
              class="status-select appearance-none bg-none bg-amber-500 text-white pl-4 pr-9 py-1.5 rounded-full font-body-sm text-body-sm border-0 focus:ring-2 focus:ring-primary cursor-pointer appearance-none text-center"
            >
                <option value="pending" selected class="bg-white text-black">Pending</option>
                <option value="approved" class="bg-white text-black">Diterima</option>
                <option value="rejected" class="bg-white text-black">Ditolak</option>
            </select>
            <span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 flex items-center">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.5 4.5L6 8L9.5 4.5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </div>

        <div class="flex justify-start sm:justify-end">
          <button
            id="berkas-btn"
            type="button"
            class="inline-flex items-center gap-1.5 bg-primary-container hover:bg-primary text-on-primary px-4 py-1.5 rounded-lg text-body-sm font-bold transition-colors"
          >
            <span class="material-symbols-outlined text-[18px]">folder_open</span>
            Berkas Persyaratan
          </button>
        </div>
      </div>

      <!-- Catatan Admin -->
      <div class="mt-6 pt-6 border-t border-outline-variant">
        <label
          for="input-catatan"
          class="block font-body-sm text-body-sm text-on-surface font-medium mb-2"
        >
          Catatan
          <span id="catatan-required-mark" class="hidden text-error">*</span>
        </label>
        <textarea
          id="input-catatan"
          rows="3"
          placeholder="Isi catatan (wajib jika status ditolak)"
          class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm resize-none"
        ></textarea>
        <p id="catatan-hint" class="mt-1 text-xs text-on-surface-variant">
          Opsional untuk status diterima, wajib diisi jika seminar ditolak.
        </p>
      </div>
  </div>

  <!-- Pesan sukses/error -->
  <div
    id="update-seminar-message"
    class="hidden mb-6 px-4 py-3 rounded-md font-body-sm text-body-sm"
  ></div>

  <!-- Form Card -->
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
    <div class="p-8">
      <form id="form-update-seminar" class="space-y-6">
        <!-- Nama -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">Nama</label>
          <div class="md:col-span-2">
            <input
              id="input-nama"
              type="text"
              readonly
              class="w-full bg-surface-container-low border-outline-variant text-on-surface-variant rounded-md shadow-sm cursor-not-allowed focus:ring-0 focus:border-outline-variant sm:text-sm"
            />
          </div>
        </div>

        <!-- NIM -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">NIM</label>
          <div class="md:col-span-2">
            <input
              id="input-nim"
              type="text"
              readonly
              class="w-full bg-surface-container-low border-outline-variant text-on-surface-variant rounded-md shadow-sm cursor-not-allowed focus:ring-0 focus:border-outline-variant sm:text-sm"
            />
          </div>
        </div>

        <!-- Program Studi -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">Program Studi</label>
          <div class="md:col-span-2">
            <input
              id="input-prodi"
              type="text"
              readonly
              class="w-full bg-surface-container-low border-outline-variant text-on-surface-variant rounded-md shadow-sm cursor-not-allowed focus:ring-0 focus:border-outline-variant sm:text-sm"
            />
          </div>
        </div>

        <!-- Dosen Pembimbing Utama -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start pt-2">
          <label class="font-body-sm text-body-sm text-on-surface font-medium mt-2">
            Dosen Pembimbing Utama
          </label>
          <div class="md:col-span-2">
            <select
              id="select-pembimbing-utama"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            >
              
            </select>
          </div>
        </div>

        <!-- Dosen Pembimbing Kedua -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
          <label class="font-body-sm text-body-sm text-on-surface font-medium mt-2">
            Dosen Pembimbing Kedua
          </label>
          <div class="md:col-span-2">
            <select
              id="select-pembimbing-kedua"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            >
              
            </select>
            <p class="mt-1 text-xs text-error">* Silahkan isi dosen pembimbing ke-2 jika ada</p>
            <p id="current-pembimbing-note" class="mt-1 text-xs text-on-surface-variant"></p>
          </div>
        </div>

        <!-- Rencana Tugas Akhir -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
          <label class="font-body-sm text-body-sm text-on-surface font-medium mt-2">
            Rencana Tugas Akhir
          </label>
          <div class="md:col-span-2">
            <textarea
              id="input-judul"
              rows="3"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            ></textarea>
            <p class="mt-1 text-xs text-error">
              * Pengisian judul harus kapital di setiap awal kata kecuali kata penghubung
            </p>
          </div>
        </div>

        <!-- Lokasi Tugas Akhir -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">Lokasi Tugas Akhir</label>
          <div class="md:col-span-2">
            <input
              id="input-lokasi"
              type="text"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            />
          </div>
        </div>

        <!-- Tanggal Seminar -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">Tanggal Seminar</label>
          <div class="md:col-span-2 relative">
            <input
              id="input-tanggal"
              type="date"
              onclick="this.showPicker()"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm cursor-pointer"
            />
          </div>
        </div>

        <!-- Waktu Seminar -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">Waktu Seminar</label>
          <div class="md:col-span-2 relative">
            <input
              id="input-waktu"
              type="time"
              onclick="this.showPicker()"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm cursor-pointer"
            />
          </div>
        </div>

        <!-- Dosen Moderator (diisi admin) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">Dosen Moderator</label>
          <div class="md:col-span-2">
            <select
              id="select-moderator"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            >
              <option value="">-- Pilih Dosen Moderator --</option>
            </select>
          </div>
        </div>

        <!-- Ruangan (diisi admin) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">Ruangan</label>
          <div class="md:col-span-2">
            <input
              id="input-ruangan"
              type="text"
              placeholder="Contoh: Ruang A101"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            />
          </div>
        </div>

        <!-- Submit Action -->
        <div class="pt-6">
          <button
            id="btn-submit-seminar"
            type="submit"
            class="w-full bg-primary-container hover:bg-primary text-white font-medium py-3 px-4 rounded-md shadow-sm transition-colors duration-200 flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined text-sm">save</span>
            Update
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<!-- Modal Berkas Syarat Administrasi (Admin) -->
  <div
    id="berkas-modal-overlay"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
  >
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-xl w-full max-w-lg max-h-[85vh] overflow-hidden flex flex-col">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-outline-variant flex items-center justify-between shrink-0">
        <h3 class="font-headline-sm text-headline-sm text-primary font-bold">Berkas Syarat Administrasi</h3>
        <button
          id="berkas-modal-close-btn"
          type="button"
          class="p-1.5 rounded-full hover:bg-surface-container transition-colors"
          title="Tutup"
        >
          <span class="material-symbols-outlined text-on-surface-variant">close</span>
        </button>
      </div>

      <!-- Modal Body: daftar berkas (view-only untuk admin) -->
      <div id="berkas-modal-body" class="p-4 flex flex-col gap-2 overflow-y-auto">
        <!-- diisi lewat JS -->
      </div>

      <!-- Verifikasi: status + catatan admin -->
      <div class="px-4 pb-4 pt-2 border-t border-outline-variant shrink-0 space-y-3">
        <div>
          <label class="block text-xs font-medium text-on-surface-variant mb-1">Status Verifikasi</label>
          <select
            id="berkas-verify-status"
            class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
          >
            <option value="menunggu_verifikasi">Menunggu Verifikasi</option>
            <option value="lengkap">Lengkap</option>
            <option value="ditolak">Ditolak</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-on-surface-variant mb-1">Catatan Admin</label>
          <textarea
            id="berkas-verify-catatan"
            rows="2"
            placeholder="Opsional, isi kalau ada berkas yang perlu diperbaiki"
            class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm resize-none"
          ></textarea>
        </div>
        <button
          id="berkas-verify-submit-btn"
          type="button"
          class="w-full bg-primary-container hover:bg-primary text-on-primary font-medium py-2.5 px-4 rounded-md shadow-sm transition-colors flex items-center justify-center gap-2"
        >
          <span class="material-symbols-outlined text-sm">check_circle</span>
          Simpan Status Verifikasi
        </button>
      </div>
    </div>
  </div>

  <script src="../../scripts/api/admin/form-update-seminar.ts"></script>