---
// src/pages/jadwal-kolokium.astro
// Halaman Jadwal Kolokium — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini; footer juga sudah ada di Layout).

import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="admin" pageTitle="Jadwal Kolokium - SISKOM DSVK" navTitle="Jadwal Kolokium">
  <!-- Content Card -->
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl flex-1 flex flex-col overflow-hidden shadow-[0px_4px_12px_rgba(0,0,0,0.03)]">
    <!-- Table Header -->
    <div class="p-6 flex flex-col items-center justify-center border-b border-outline-variant">
      <h2 class="font-headline-md text-headline-md text-primary font-bold tracking-wide">TABEL KOLOKIUM</h2>
    </div>

    <!-- Search and Entries Filter -->
    <div class="px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-surface-container-low/50">
      <div class="flex items-center gap-2 text-body-sm text-on-surface-variant">
        <span>Show</span>
        <select class="border border-outline-variant rounded bg-surface px-2 py-1 outline-none focus:border-primary">
          <option>5</option>
          <option>10</option>
          <option>25</option>
        </select>
        <span>entries</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-body-sm text-on-surface-variant">Search:</span>
        <input
          id="jadwal-kolokium-search"
          type="text"
          placeholder="Cari nama, NIM, judul, dosen, dll..."
          class="px-3 py-1 border border-outline-variant rounded-lg w-full sm:w-64 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
        />
      </div>
    </div>

    <!-- Table Container -->
    <div class="flex-1 overflow-x-auto custom-scrollbar">
      <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-high sticky top-0 z-10">
          <tr>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              No <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Nama <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              NIM <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Prodi <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Dosen Pembimbing <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Judul <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Lokasi <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Tanggal <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Waktu <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Mahasiswa Pembahas <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Moderator <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Ruangan <span class="material-symbols-outlined text-[12px]">unfold_more</span>
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Status
            </th>
            <th class="px-4 py-4 font-label-md text-label-md text-on-surface-variant border-b border-outline-variant whitespace-nowrap">
              Aksi
            </th>
          </tr>
        </thead>
        <tbody id="jadwal-kolokium-tbody" class="divide-y divide-outline-variant/30">
          <tr>
            <td colspan="14" class="px-4 py-8 text-center text-body-sm text-on-surface-variant">
              Memuat data...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer -->
    <div class="px-6 py-4 border-t border-outline-variant flex flex-col sm:flex-row items-center justify-between gap-4 bg-surface-container-low/30">
      <p id="jadwal-kolokium-pagination-info" class="text-body-sm text-on-surface-variant">Memuat data...</p>
      <div class="flex items-center gap-1">
        <button id="jadwal-kolokium-first-btn" class="px-3 py-1 text-body-sm border border-outline-variant rounded hover:bg-surface-container transition-colors disabled:opacity-40 disabled:cursor-not-allowed">First</button>
        <button id="jadwal-kolokium-prev-btn" class="px-3 py-1 text-body-sm border border-outline-variant rounded hover:bg-surface-container transition-colors disabled:opacity-40 disabled:cursor-not-allowed">«</button>
        <span id="jadwal-kolokium-page-label" class="px-3 py-1 text-body-sm bg-ipb-blue text-white rounded font-bold whitespace-nowrap">1 / 1</span>
        <button id="jadwal-kolokium-next-btn" class="px-3 py-1 text-body-sm border border-outline-variant rounded hover:bg-surface-container transition-colors disabled:opacity-40 disabled:cursor-not-allowed">»</button>
        <button id="jadwal-kolokium-last-btn" class="px-3 py-1 text-body-sm border border-outline-variant rounded hover:bg-surface-container transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Last</button>
      </div>
    </div>
  </div>

  <script src="../../scripts/api/admin/jadwal-kolokium.ts"></script>
</Layout>