---
// src/pages/profil-admin.astro
// Halaman Profil Admin — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini; footer juga sudah ada di Layout).

import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="admin" pageTitle="Profil Admin - SISKOM DSVK" navTitle="Profil Admin">
  <div class="flex-1 flex flex-col gap-6">

    <!-- ==================== CARD: DATA PROFIL ==================== -->
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.03)]">
      <div class="p-6 border-b border-outline-variant space-y-1">
        <h2 class="font-headline-md text-headline-md text-primary font-bold">PROFIL ADMIN</h2>
        <p class="text-body-sm text-on-surface-variant">
          Kelola informasi akun admin Anda.
        </p>
      </div>

      <form id="profil-form" class="p-6 space-y-5 max-w-xl">
        <!-- Pesan status (diisi oleh admin-profile.ts) -->
        <p id="profil-form-message" class="hidden text-body-sm font-medium"></p>

        <!-- Username (read only) -->
        <div class="space-y-1.5">
          <label for="username" class="text-label-md font-medium text-on-surface">
            Username
          </label>
          <div class="relative">
            <input
              id="username"
              name="username"
              type="text"
              value="admin"
              readonly
              class="w-full pl-4 pr-10 py-2.5 border border-outline-variant rounded-lg bg-surface-container-low text-on-surface-variant cursor-not-allowed outline-none"
            />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline text-lg">
              lock
            </span>
          </div>
          <p class="text-body-sm text-outline">Username tidak dapat diubah.</p>
        </div>

        <!-- Nama -->
        <div class="space-y-1.5">
          <label for="nama" class="text-label-md font-medium text-on-surface">
            Nama
          </label>
          <input
            id="nama"
            name="nama"
            type="text"
            placeholder="Masukkan nama lengkap"
            value="Memuat..."
            class="w-full px-4 py-2.5 border border-outline-variant rounded-lg bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
          />
        </div>

        <!-- Email -->
        <div class="space-y-1.5">
          <label for="email" class="text-label-md font-medium text-on-surface">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="nama@domain.com"
            value="Memuat..."
            class="w-full px-4 py-2.5 border border-outline-variant rounded-lg bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
          />
        </div>

        <!-- Actions -->
        <div class="pt-2 flex items-center gap-3">
          <button
            type="submit"
            id="profil-submit"
            class="px-5 py-2.5 bg-ipb-blue text-white text-label-md font-bold rounded-lg hover:opacity-90 transition-opacity"
          >
            Simpan Perubahan
          </button>
          <button
            type="reset"
            class="px-5 py-2.5 border border-outline-variant text-on-surface-variant text-label-md font-medium rounded-lg hover:bg-surface-container transition-colors"
          >
            Batal
          </button>
        </div>
      </form>
    </div>

    <!-- ==================== CARD: UBAH PASSWORD ==================== -->
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.03)]">
      <div class="p-6 border-b border-outline-variant space-y-1">
        <h2 class="font-headline-md text-headline-md text-primary font-bold">UBAH PASSWORD</h2>
        <p class="text-body-sm text-on-surface-variant">
          Perbarui password akun Anda secara berkala untuk menjaga keamanan.
        </p>
      </div>

      <form id="ubah-password-form" class="p-6 space-y-5 max-w-xl">
        <!-- Pesan status (diisi oleh change-password.ts) -->
        <p id="password-form-message" class="hidden text-body-sm font-medium"></p>

        <!-- Current Password -->
        <div class="space-y-1.5">
          <label for="current-password" class="text-label-md font-medium text-on-surface">
            Password Saat Ini
          </label>
          <div class="relative">
            <input
              id="current-password"
              name="current-password"
              type="password"
              placeholder="Masukkan password saat ini"
              class="w-full pl-4 pr-10 py-2.5 border border-outline-variant rounded-lg bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
            />
            <button
              type="button"
              class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface-variant"
              data-target="current-password"
              aria-label="Tampilkan password"
            >
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
        </div>

        <!-- New Password -->
        <div class="space-y-1.5">
          <label for="new-password" class="text-label-md font-medium text-on-surface">
            Password Baru
          </label>
          <div class="relative">
            <input
              id="new-password"
              name="new-password"
              type="password"
              placeholder="Minimal 8 karakter"
              class="w-full pl-4 pr-10 py-2.5 border border-outline-variant rounded-lg bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
            />
            <button
              type="button"
              class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface-variant"
              data-target="new-password"
              aria-label="Tampilkan password"
            >
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
        </div>

        <!-- Confirm Password -->
        <div class="space-y-1.5">
          <label for="confirm-password" class="text-label-md font-medium text-on-surface">
            Konfirmasi Password Baru
          </label>
          <div class="relative">
            <input
              id="confirm-password"
              name="confirm-password"
              type="password"
              placeholder="Ulangi password baru"
              class="w-full pl-4 pr-10 py-2.5 border border-outline-variant rounded-lg bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
            />
            <button
              type="button"
              class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface-variant"
              data-target="confirm-password"
              aria-label="Tampilkan password"
            >
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
          <p id="password-hint" class="text-body-sm text-outline">
            Password baru dan konfirmasi harus sama.
          </p>
        </div>

        <!-- Actions -->
        <div class="pt-2 flex items-center gap-3">
          <button
            type="submit"
            id="ubah-password-submit"
            class="px-5 py-2.5 bg-ipb-blue text-white text-label-md font-bold rounded-lg hover:opacity-90 transition-opacity"
          >
            Ubah Password
          </button>
          <button
            type="reset"
            class="px-5 py-2.5 border border-outline-variant text-on-surface-variant text-label-md font-medium rounded-lg hover:bg-surface-container transition-colors"
          >
            Batal
          </button>
        </div>
      </form>
    </div>

  </div>

  <script>
    import "../../scripts/profile-admin.ts";
  </script>

  <script>
    // Ubah Password — script generik (juga dipakai di halaman profil dosen/mahasiswa)
    import "../../scripts/api/change-password.ts";
  </script>

  <script>
    // GET & PATCH data profil admin (nama, email)
    import "../../scripts/api/admin/profile.ts";
  </script>
</Layout>