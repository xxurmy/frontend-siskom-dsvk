---
// src/pages/daftar-kolokium.astro
// Halaman Daftar Kolokium — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini).

import Layout from "../../layouts/Layout.astro";
---

<Layout
  userRole="mahasiswa"
  pageTitle="Daftar Kolokium - SISKOM DSVK"
  navTitle="Daftar Kolokium"
>
  <!-- Pesan status -->
  <div
    id="kolokium-message"
    class="hidden mb-4 px-4 py-3 rounded-lg text-body-sm font-medium"
  ></div>

  <!-- Status Card -->
  <div
    id="status-card"
    class="hidden bg-surface-container-lowest border border-outline-variant rounded-xl p-8 mb-6 shadow-sm"
  >
    <div class="flex flex-col gap-3 sm:grid sm:grid-cols-3 sm:items-center">
      <h2 class="font-title-lg text-title-lg text-on-surface">
        Status Kolokium
      </h2>

      <div class="flex justify-start sm:justify-center">
        <span
          id="status-badge"
          class="bg-outline text-white px-4 py-1.5 rounded-full font-body-sm text-body-sm"
        >
          Belum Mendaftar
        </span>
      </div>

      <div class="flex justify-start sm:justify-end">
        <button
          id="berkas-btn"
          type="button"
          class="hidden items-center gap-1.5 bg-primary-container hover:bg-primary text-on-primary px-4 py-1.5 rounded-lg text-body-sm font-bold transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">folder_open</span>
          Berkas Persyaratan
        </button>
      </div>
    </div>

    <!-- Catatan Admin: hanya tampil kalau status rejected/approved DAN catatan terisi -->
    <div id="catatan-wrapper" class="hidden mt-6 pt-6 border-t border-outline-variant">
      <label class="block font-body-sm text-body-sm text-on-surface font-medium mb-2">
        Catatan dari Admin
      </label>
      <textarea
        id="catatan-textarea"
        readonly
        rows="3"
        class="w-full bg-surface-container-low border-outline-variant text-on-surface-variant rounded-md shadow-sm cursor-not-allowed focus:ring-0 focus:border-outline-variant sm:text-sm resize-none"
      ></textarea>
    </div>
  </div>

  <!-- Form Card -->
  <div
    id="form-wrapper"
    class="hidden bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden"
  >
    <div class="p-8">
      <form id="kolokium-form" class="space-y-6">

        <!-- Nama -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">
            Nama
          </label>

          <div class="md:col-span-2">
            <input
              id="nama-input"
              type="text"
              readonly
              class="w-full bg-surface-container-low border-outline-variant text-on-surface-variant rounded-md shadow-sm cursor-not-allowed focus:ring-0 focus:border-outline-variant sm:text-sm"
            />
          </div>
        </div>

        <!-- NIM -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">
            NIM
          </label>

          <div class="md:col-span-2">
            <input
              id="nim-input"
              type="text"
              readonly
              class="w-full bg-surface-container-low border-outline-variant text-on-surface-variant rounded-md shadow-sm cursor-not-allowed focus:ring-0 focus:border-outline-variant sm:text-sm"
            />
          </div>
        </div>

        <!-- Program Studi -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">
            Program Studi
          </label>

          <div class="md:col-span-2">
            <input
              id="prodi-input"
              type="text"
              readonly
              class="w-full bg-surface-container-low border-outline-variant text-on-surface-variant rounded-md shadow-sm cursor-not-allowed focus:ring-0 focus:border-outline-variant sm:text-sm"
            />
          </div>
        </div>

        <!-- Dosen Pembimbing Utama -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start pt-2">
          <label class="font-body-sm text-body-sm text-on-surface font-medium mt-2">
            Dosen Pembimbing Utama
          </label>

          <div class="md:col-span-2">
            <select
              id="pembimbing-utama-select"
              required
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            >
              <option value="">
                -- Pilih Dosen Pembimbing Utama --
              </option>
            </select>
          </div>
        </div>

        <!-- Dosen Pembimbing Kedua -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
          <label class="font-body-sm text-body-sm text-on-surface font-medium mt-2">
            Dosen Pembimbing Kedua
          </label>

          <div class="md:col-span-2">
            <select
              id="pembimbing-kedua-select"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            >
              <option value="">
                -- Pilih Dosen Pembimbing Kedua --
              </option>
            </select>

            <p class="mt-1 text-xs text-error">
              * Silahkan isi dosen pembimbing ke-2 jika ada
            </p>
          </div>
        </div>

        <!-- Judul -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
          <label class="font-body-sm text-body-sm text-on-surface font-medium mt-2">
            Rencana Tugas Akhir
          </label>

          <div class="md:col-span-2">
            <textarea
              id="judul-textarea"
              required
              rows="3"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            ></textarea>

            <p class="mt-1 text-xs text-error">
              * Pengisian judul harus kapital di setiap awal kata kecuali kata penghubung
            </p>
          </div>
        </div>

        <!-- Lokasi -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">
            Lokasi Tugas Akhir
          </label>

          <div class="md:col-span-2">
            <input
              id="lokasi-input"
              required
              type="text"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm"
            />
          </div>
        </div>

        <!-- Tanggal -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">
            Tanggal Kolokium
          </label>

          <div class="md:col-span-2">
            <input
              id="tanggal-input"
              type="date"
              onclick="this.showPicker()"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm cursor-pointer"
            />
          </div>
        </div>

        <!-- Waktu -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">
            Waktu Kolokium
          </label>

          <div class="md:col-span-2">
            <input
              id="waktu-input"
              type="time"
              onclick="this.showPicker()"
              class="w-full bg-surface-container-lowest border-outline-variant text-on-surface rounded-md shadow-sm focus:ring-primary focus:border-primary sm:text-sm cursor-pointer"
            />
          </div>
        </div>

        <!-- Informasi -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">
            Dosen Moderator
          </label>

          <div class="md:col-span-2">
            <span class="text-on-surface-variant text-body-sm">
              (akan diisi oleh panitia)
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
          <label class="font-body-sm text-body-sm text-on-surface font-medium">
            Ruangan
          </label>

          <div class="md:col-span-2">
            <span class="text-on-surface-variant text-body-sm">
              (akan diisi oleh panitia)
            </span>
          </div>
        </div>

        <!-- Submit -->
        <div class="pt-6">
          <button
            id="submit-btn"
            type="submit"
            class="w-full bg-primary-container hover:bg-primary text-white font-medium py-3 px-4 rounded-md shadow-sm transition-colors duration-200 flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined text-sm">save</span>
            Kirim
          </button>
        </div>

      </form>
    </div>
  </div>
</Layout>

<!-- Modal Berkas Syarat Administrasi -->
  <div
    id="berkas-modal-overlay"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
  >
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-xl w-full max-w-lg max-h-[85vh] overflow-hidden flex flex-col">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-outline-variant flex items-center justify-between shrink-0">
        <div>
          <h3 class="font-headline-sm text-headline-sm text-primary font-bold">Berkas Syarat Administrasi</h3>
          <p id="berkas-modal-status" class="text-body-sm text-on-surface-variant mt-0.5"></p>
        </div>
        <button
          id="berkas-modal-close-btn"
          type="button"
          class="p-1.5 rounded-full hover:bg-surface-container transition-colors"
          title="Tutup"
        >
          <span class="material-symbols-outlined text-on-surface-variant">close</span>
        </button>
      </div>

      <!-- Catatan admin (kalau ada) -->
      <div id="berkas-catatan-wrapper" class="hidden px-6 pt-4 shrink-0">
        <div class="bg-surface-container-low border border-outline-variant rounded-lg p-3">
          <p class="text-xs font-medium text-on-surface-variant mb-1">Catatan dari Admin</p>
          <p id="berkas-catatan-text" class="text-body-sm text-on-surface"></p>
        </div>
      </div>

      <!-- Modal Body: daftar berkas -->
      <div id="berkas-modal-body" class="p-4 flex flex-col gap-3 overflow-y-auto">
        <!-- diisi lewat JS -->
      </div>
    </div>
  </div>

  <script src="../../scripts/api/mahasiswa/daftar-kolokium.ts"></script>