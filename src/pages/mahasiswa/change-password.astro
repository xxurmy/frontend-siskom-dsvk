---
// src/pages/profil-admin.astro
// Halaman Profil Admin — pakai Layout.astro yang sudah ada
// (Navbar + Sidebar tidak dibuat ulang di sini; footer juga sudah ada di Layout).

import Layout from "../../layouts/Layout.astro";
---

<Layout userRole="mahasiswa" pageTitle="Ubah Password - SISKOM DSVK" navTitle="Ubah Password">
  <div id="ubah-password-page" class="flex-1 flex flex-col gap-6">

    <!-- ==================== CARD: UBAH PASSWORD ==================== -->
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.03)]">
      <div class="p-6 border-b border-outline-variant space-y-1">
        <h2 class="font-headline-md text-headline-md text-primary font-bold">UBAH PASSWORD</h2>
        <p class="text-body-sm text-on-surface-variant">    
          Perbarui password akun Anda secara berkala untuk menjaga keamanan.
        </p>
      </div>

      <form id="ubah-password-form" class="p-6 space-y-5 max-w-xl">
        <!-- Current Password -->
        <div class="space-y-1.5">
          <label for="current-password" class="text-label-md font-medium text-on-surface">
            Password Saat Ini
          </label>
          <div class="relative">
            <input
              id="current-password"
              name="current-password"
              type="password"
              placeholder="Masukkan password saat ini"
              class="w-full pl-4 pr-10 py-2.5 border border-outline-variant rounded-lg bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
            />
            <button
              type="button"
              class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface-variant"
              data-target="current-password"
              aria-label="Tampilkan password"
            >
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
        </div>

        <!-- New Password -->
        <div class="space-y-1.5">
          <label for="new-password" class="text-label-md font-medium text-on-surface">
            Password Baru
          </label>
          <div class="relative">
            <input
              id="new-password"
              name="new-password"
              type="password"
              placeholder="Minimal 8 karakter"
              class="w-full pl-4 pr-10 py-2.5 border border-outline-variant rounded-lg bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
            />
            <button
              type="button"
              class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface-variant"
              data-target="new-password"
              aria-label="Tampilkan password"
            >
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
        </div>

        <!-- Confirm Password -->
        <div class="space-y-1.5">
          <label for="confirm-password" class="text-label-md font-medium text-on-surface">
            Konfirmasi Password Baru
          </label>
          <div class="relative">
            <input
              id="confirm-password"
              name="confirm-password"
              type="password"
              placeholder="Ulangi password baru"
              class="w-full pl-4 pr-10 py-2.5 border border-outline-variant rounded-lg bg-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
            />
            <button
              type="button"
              class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface-variant"
              data-target="confirm-password"
              aria-label="Tampilkan password"
            >
              <span class="material-symbols-outlined text-lg">visibility</span>
            </button>
          </div>
          <p id="password-hint" class="text-body-sm text-outline">
            Password baru dan konfirmasi harus sama.
          </p>
        </div>

        <!-- Pesan sukses / error dari server -->
        <p id="password-form-message" class="text-body-sm hidden"></p>

        <!-- Actions -->
        <div class="pt-2 flex items-center gap-3">
          <button
            id="ubah-password-submit"
            type="submit"
            class="px-5 py-2.5 bg-ipb-blue text-white text-label-md font-bold rounded-lg hover:opacity-90 transition-opacity disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Ubah Password
          </button>
          <button
            type="reset"
            class="px-5 py-2.5 border border-outline-variant text-on-surface-variant text-label-md font-medium rounded-lg hover:bg-surface-container transition-colors"
          >
            Batal
          </button>
        </div>
      </form>
    </div>

  </div>

<script src="../../scripts/api/mahasiswa/password-mahasiswa.ts"></script>
</Layout>